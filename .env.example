# --- AI 슬롯 ---
AI_BACKEND=mock
AI_ENDPOINT=
AI_TIMEOUT_S=60

# --- 지도/경로 ---
GEOCODER=mock
ROUTER=osrm
OSRM_BASE_URL=http://127.0.0.1:5000
ROUTER_TIMEOUT_S=5
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 보안/동작 ---
AUTH_DB_PATH=backend/data/auth.sqlite3
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_HOURS=168
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ONLINE_HOSTS=www.coupang.com,search.shopping.naver.com,search.11st.co.kr,browse.gmarket.co.kr
MAX_RESULTS=30
LOG_LEVEL=INFO

# --- 프론트(빌드 시 주입) ---
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_FEATURE_TRANSIT=false
